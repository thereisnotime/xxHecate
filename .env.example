XXHECATE_INVENTORY="inventory.csv"
XXHECATE_LOG_FILE="xxHecate.log"

# Loop mode. 0 (default) walks the inventory once and exits, which is what cron
# and a systemd timer expect. 1 keeps running and re-walks every
# XXHECATE_SLEEP_DURATION seconds, for use as a long-lived service with no timer.
XXHECATE_LOOP="0"
XXHECATE_SLEEP_DURATION="60"

# Optional known_hosts file used to verify hosts that run a booted OS (the
# truenas-zfs method). Leave empty to skip host-key checking (a warning is
# logged). The luks method is always unverified: an initramfs presents a
# different host key than the booted system.
# Build one with: ssh-keyscan -p 22 <host> >> known_hosts
XXHECATE_KNOWN_HOSTS=""
